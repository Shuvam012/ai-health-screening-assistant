# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/health-screening

# API Keys (Required)
# Get your Sarvam API key at: https://www.sarvam.ai
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# Get your Gemini API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Backup providers (Uncomment if needed)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# AI Providers
STT_PROVIDER=sarvam
LLM_PROVIDER=gemini
TTS_PROVIDER=sarvam

# Model Configuration
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
GEMINI_MODEL=gemini-2.0-flash

# CORS
CORS_ORIGIN=http://localhost:5173
